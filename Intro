<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Fred Vargas — présentation</title>
<style>
  :root{
    --paper:#E9E5DC;
    --ink:#16130F;
    --green:#1F7A4A;
    --purple:#7030A0;
    --blue:#2E74B5;
    --grain:rgba(22,19,15,.10);
  }
  *{box-sizing:border-box}
  html,body{height:100%;margin:0}
  body{
    background:var(--paper);color:var(--ink);
    font:400 18px/1.5 "Helvetica Neue",Arial,sans-serif;overflow:hidden;
  }
  body::before{
    content:"";position:fixed;inset:0;pointer-events:none;z-index:0;
    background:
      radial-gradient(120% 90% at 80% 0%,rgba(255,255,255,.55),transparent 60%),
      radial-gradient(90% 80% at 0% 100%,rgba(22,19,15,.07),transparent 60%);
  }
  .deck{position:relative;height:100%;z-index:1}
  .slide{position:absolute;inset:0;display:none;grid-template-rows:auto 1fr;
    padding:clamp(18px,2.4vw,34px) clamp(26px,4vw,64px) 74px;}
  .slide.on{display:grid}

  .head{display:flex;align-items:center;gap:clamp(14px,2vw,28px);
    border-bottom:1px solid var(--grain);padding-bottom:10px}
  .head img{height:clamp(38px,4vw,54px);width:auto;flex:none}
  .head .kicker{
    font:italic 700 clamp(26px,3.1vw,44px)/1.1 Georgia,"Times New Roman",serif;
    color:var(--purple);
  }

  h1{font:italic 700 clamp(46px,7.4vw,96px)/1 Georgia,serif;color:var(--green);margin:0;letter-spacing:-.01em}
  h2{font:700 clamp(21px,2.35vw,33px)/1.2 "Helvetica Neue",Arial,sans-serif;color:var(--ink);margin:0 0 4px}
  .lede{font-size:clamp(19px,1.85vw,27px);max-width:44ch;color:#3a352e;margin:10px 0 0}

  .body{display:grid;grid-template-columns:1.2fr .8fr;gap:clamp(20px,3vw,48px);
    align-items:start;padding-top:clamp(12px,2vw,26px);min-height:0;overflow:auto}
  .body.solo{grid-template-columns:1fr}
  .body.solo ul.pts{max-width:76ch}
  .body.solo .lede{max-width:70ch}
  .body::-webkit-scrollbar{width:8px}
  .body::-webkit-scrollbar-thumb{background:rgba(22,19,15,.18)}
  .col{min-width:0}

  ul.pts{list-style:none;margin:16px 0 0;padding:0;max-width:50ch}
  ul.pts li{
    position:relative;padding:0 0 0 30px;margin:0 0 16px;
    font-size:clamp(19px,1.8vw,26px);line-height:1.45;
    opacity:0;transform:translateY(8px);transition:opacity .45s ease,transform .45s ease;
  }
  ul.pts li.show{opacity:1;transform:none}
  ul.pts li::before{content:"";position:absolute;left:0;top:.62em;width:14px;height:3px;background:var(--blue)}
  ul.pts li b{color:var(--purple)}
  ul.pts li em{font-style:italic;color:var(--green);font-weight:700}

  .quote{
    border-left:4px solid var(--green);padding:4px 0 4px 22px;margin:18px 0 0;
    font:italic 400 clamp(20px,2vw,29px)/1.35 Georgia,serif;color:#2c2822;max-width:44ch;
  }
  .quote span{display:block;font:400 clamp(14px,1.1vw,17px)/1.4 "Helvetica Neue",Arial,sans-serif;
    color:#6b665e;margin-top:10px;font-style:normal}

  .reveal{
    margin:20px 0 0;border:2px solid var(--blue);background:rgba(255,255,255,.45);
    padding:16px 20px;max-width:52ch;
    opacity:0;transform:translateY(8px);transition:opacity .45s ease,transform .45s ease;
  }
  .reveal.show{opacity:1;transform:none}
  .reveal h3{margin:0 0 8px;font:italic 700 clamp(20px,2vw,28px)/1.2 Georgia,serif;color:var(--blue)}
  .reveal p{margin:0 0 8px;font-size:clamp(17px,1.55vw,22px);line-height:1.45}
  .reveal p:last-child{margin:0}
  .reveal b{color:var(--purple)}

  .note{margin-top:22px;padding-top:12px;border-top:1px solid var(--grain);
    font-size:clamp(15px,1.25vw,19px);color:#6b665e;max-width:52ch}
  .note b{color:var(--purple);font-style:italic}
  .punch{margin-top:26px;font:italic 700 clamp(22px,2.3vw,34px)/1.25 Georgia,serif;color:var(--green);
    opacity:0;transform:translateY(8px);transition:opacity .45s ease,transform .45s ease}
  .punch.show{opacity:1;transform:none}
  .link{
    display:inline-block;margin:18px 0 0;background:var(--blue);color:#fff;text-decoration:none;
    padding:12px 20px;font-size:clamp(16px,1.5vw,21px);border-radius:2px;
  }
  .link:hover{background:#1e5c96}

  .photo{
    position:relative;width:100%;height:clamp(280px,58vh,620px);
    border:2px dashed rgba(112,48,160,.45);border-radius:2px;background:rgba(255,255,255,.45);
    display:flex;align-items:center;justify-content:center;text-align:center;cursor:pointer;overflow:hidden;
  }
  .photo.short{height:clamp(200px,34vh,320px)}
  .photo:hover,.photo:focus-visible{border-color:var(--purple);outline:none}
  .photo .hint{padding:16px;font-size:15px;color:#6b665e}
  .photo img{display:none}
  .photo.filled{border:1px solid rgba(22,19,15,.18);background:none;height:auto;width:fit-content;margin:0 auto;display:block}
  .photo.filled img{display:block;max-width:100%;max-height:62vh;width:auto;height:auto}
  .photo.filled .hint{display:none}
  .photo .swap{
    position:absolute;right:8px;bottom:8px;display:none;background:rgba(22,19,15,.78);color:#fff;
    border:0;border-radius:2px;font:400 13px/1 "Helvetica Neue",Arial,sans-serif;padding:8px 11px;cursor:pointer;
  }
  .photo:hover .swap{display:block}
  .photo.drag{border-color:var(--green);background:rgba(31,122,74,.08)}
  .stack{display:grid;gap:16px;justify-items:center}
  .stack .photo{height:clamp(150px,27vh,265px)}
  .stack .photo.filled{height:auto}
  .stack .photo.filled img{max-height:28vh}

  /* couverture et diapo finale */
  .cover .body{align-items:center}
  .cover .inner{display:flex;flex-direction:column;align-items:flex-start;gap:8px}
  .cover .sub{font:700 clamp(19px,2.1vw,30px)/1.3 "Helvetica Neue",Arial,sans-serif;color:var(--purple)}
  .cover .book{font:italic 400 clamp(17px,1.7vw,24px)/1.4 Georgia,serif;color:#6b665e}
  .mark{width:clamp(110px,13vw,175px);height:auto;margin-bottom:4px}
  .mark path,.mark line{fill:none;stroke:var(--ink);stroke-width:9;stroke-linecap:square;
    stroke-dasharray:520;stroke-dashoffset:520}
  .on .mark path,.on .mark line{animation:draw 1.5s .25s ease-out forwards}
  .mark .clt{font:700 32px/1 Georgia,serif;fill:var(--ink);opacity:0}
  .on .mark .clt{animation:fade .7s 1.5s ease-out forwards}
  @keyframes draw{to{stroke-dashoffset:0}}
  @keyframes fade{to{opacity:1}}

  .end{text-align:center}
  .end .body{align-content:center}
  .end .big{font:italic 700 clamp(52px,8vw,110px)/1 Georgia,serif;color:var(--green);margin-bottom:18px}
  .end p{font-size:clamp(20px,2vw,28px);max-width:34ch;margin:0 auto 14px;color:#3a352e}

  .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(16px,2.6vw,38px);margin-top:22px}
  .stat{opacity:0;transform:translateY(10px);transition:opacity .5s ease,transform .5s ease}
  .stat.show{opacity:1;transform:none}
  .stat .n{font:italic 700 clamp(42px,5.6vw,80px)/1 Georgia,serif;color:var(--green)}
  .stat .t{font-size:clamp(16px,1.35vw,20px);color:#3a352e;margin-top:6px;max-width:20ch}

  .flip{display:inline-block;border-bottom:3px solid var(--blue);cursor:pointer;color:var(--blue);font-weight:700}
  .flip .after{display:none}
  .flip.open .before{display:none}
  .flip.open .after{display:inline;color:var(--green)}

  .foot{position:fixed;left:0;right:0;bottom:0;height:54px;z-index:5;display:flex;align-items:center;gap:14px;
    padding:0 clamp(20px,4vw,40px);border-top:1px solid var(--grain);background:rgba(233,229,220,.94)}
  .foot button{background:none;border:1px solid rgba(22,19,15,.25);color:var(--ink);
    font:400 15px/1 "Helvetica Neue",Arial,sans-serif;padding:10px 14px;border-radius:2px;cursor:pointer}
  .foot button:hover{border-color:var(--ink)}
  .foot .count{font-size:15px;color:#6b665e;min-width:64px}
  .tip{font-size:14px;color:#6b665e;margin-left:auto}
  .bar{position:fixed;left:0;bottom:54px;height:3px;background:var(--green);width:0;transition:width .35s ease;z-index:6}

  @media (max-width:900px){
    .body{grid-template-columns:1fr}
    .photo{height:38vh}
    .stats{grid-template-columns:1fr}
    .tip{display:none}
  }
  @media (prefers-reduced-motion:reduce){
    *{animation:none!important;transition:none!important}
    ul.pts li,.stat,.reveal{opacity:1;transform:none}
    .mark path,.mark line{stroke-dashoffset:0}
    .mark .clt{opacity:1}
  }
</style>
</head>
<body>
<div class="deck" id="deck"></div>
<div class="bar" id="bar"></div>
<div class="foot">
  <button id="prev">Précédent</button>
  <button id="next">Suivant</button>
  <span class="count" id="count"></span>
  <span class="tip">Flèches pour avancer, clic sur une image pour la remplacer</span>
</div>
<input type="file" id="picker" accept="image/*" hidden>

<script>
const IMG = {"livre": "data:image/jpeg;base64,", "bureau": "data:image/jpeg;base64,", "peinture": "data:image/jpeg;base64,", "fouilles": "data:image/jpeg;base64,", "soeurs": "data:image/jpeg;base64,", "jo": "data:image/jpeg;base64,", "ava": "data:image/jpeg;base64,", "sansfeu": "data:image/jpeg;base64,", "trio": "data:image/jpeg;base64,", "adamsberg": "data:image/jpeg;base64,", "crieur": "data:image/jpeg;base64,", "avicenne": "data:image/jpeg;base64,", "battisti": "data:image/jpeg;base64,", "ardisson": "data:image/jpeg;base64,", "lueur": "data:image/jpeg;base64,", "logo": "data:image/png;base64,"};

const slides = [
  { type:'cover', img:'livre' },

  { kicker:'Pour commencer',
    h:'Une scientifique de la peste qui écrit des romans',
    lede:"Avant d'être écrivaine, elle a passé des années à étudier comment la peste passe de l'animal à l'homme.",
    stats:[
      {n:'5 ans', t:'de recherche sur la transmission de la peste'},
      {n:'21', t:'jours pour écrire un roman'},
      {n:'1', t:'seul livre : ce qu\u2019elle pensait écrire au départ'}
    ],
    punch:'En 2026, elle a publié son quinzième roman !',
    img:'bureau' },

  { kicker:'Qui est-elle ?', h:'Frédérique Audoin-Rouzeau',
    pts:[
      'Née le <b>7 juin 1957</b> à Paris.',
      "Docteur en histoire en 1983, chercheuse au <b>CNRS</b>, puis à l'<b>Institut Pasteur</b>.",
      "Spécialité : l'<em>archéozoologie</em>, l'étude des ossements d'animaux sur les chantiers de fouilles.",
      "Deux vies, deux noms : la science signée Audoin-Rouzeau, les romans signés Fred Vargas."
    ],
    note:'<b>un chantier de fouilles</b> = an archaeological dig site',
    img:'peinture' },

  { kicker:'Le terrain', h:'Elle a vraiment creusé',
    pts:[
      "Elle participe activement à des <b>fouilles archéologiques</b> : rue de Lutèce à Paris, monastère de La Charité-sur-Loire, chantiers de la Nièvre.",
      "Son grand livre scientifique sur la peste noire est sorti en <b>2003</b>, deux ans après son roman <em>Pars vite et reviens tard</em>.",
      "Elle a écrit son premier roman pendant qu'elle travaillait sur un chantier archéologique.",
      "Tu savais que Paris, <b>Lutèce</b> en latin, existe depuis environ <b>300 ans avant Jésus-Christ</b> ?"
    ],
    img:'fouilles' },

  { kicker:'La famille', h:'Une maison pleine de têtes têtues',
    pts:[
      "Le père : écrivain du mouvement <b>surréaliste</b>, une écriture instinctive, sans logique.",
      "La mère : ingénieure chimiste.",
      "Le frère, <b>Stéphane</b> : grand historien de la Première Guerre mondiale.",
      "La sœur jumelle, <b>Jo Vargas</b> : peintre, et première lectrice de tous ses romans."
    ],
    stack:['soeurs','jo'] },

  { kicker:'Le pseudonyme', h:'Pourquoi « Vargas » ?',
    pts:[
      "D'abord, c'est sa sœur jumelle <b>Jo</b> qui a choisi le pseudonyme « Vargas », pour signer ses tableaux.",
      "Le nom vient de <em>Maria Vargas</em>, le personnage joué par <b>Ava Gardner</b> dans le film La Comtesse aux pieds nus.",
      "Frédérique avait besoin d'un faux nom : elle présentait sa candidature au CNRS et ne voulait pas compliquer les choses.",
      "Elle ne pouvait pas prendre un autre faux nom que celui de sa jumelle.",
      "Elle a donc choisi <b>Fred Vargas</b> comme pseudonyme."
    ],
    img:'ava' },

  { kicker:'Sa méthode', h:'Vingt et un jours par an',
    pts:[
      "Elle écrit pendant ses <b>vacances d'été</b> : environ vingt et un jours pour le premier jet.",
      "Elle corrige à <b>Noël</b> et à <b>Pâques</b>. Sa sœur relit, et elle est sévère."
    ],
    quote:{t:"Elle est venue au roman policier pour deux raisons : le métier de chercheur n\u2019était pas très drôle, et parce qu\u2019elle était passionnée d\u2019accordéon mais n\u2019a pas eu le succès espéré.", s:'Fred Vargas, en entretien'},
    img:'sansfeu' },

  { kicker:'Son mot à elle', h:'Un rompol, c\u2019est quoi ?',
    lede:"Fred Vargas n'aime pas le mot « roman policier ». Elle a inventé le sien : la contraction de <b>rom</b>an <b>pol</b>icier.",
    pts:[
      "Un rompol assume avant tout d'être <b>un vrai roman</b>.",
      "La liberté du récit, la poésie, l'humour et la force des personnages comptent <b>autant que l'enquête</b>.",
      "Le crime existe, mais l'atmosphère est proche du <em>conte</em>.",
      "Le style compte autant que la solution du mystère."
    ]},

  { kicker:'Son style', h:'Attention : ce n\u2019est pas un thriller américain !',
    pts:[
      'Très peu de sang, presque pas de sexe.',
      'Énormément de <b>dialogues</b> : les personnages parlent, se disputent, racontent.',
      'Des personnages tous décalés, cassés par la vie, drôles sans le vouloir.',
      "La difficulté pour toi ne sera pas la grammaire, mais le <b>vocabulaire</b> et l'humour."
    ],
    img:'trio' },

  { kicker:'Le commissaire', h:'Jean-Baptiste Adamsberg',
    pts:[
      "Le contraire du policier efficace : lent, distrait, il rêve, il marche, il écoute son intuition.",
      "On le surnomme parfois <em>le pelleteur de nuages</em>.",
      "À côté de lui, son adjoint <b>Danglard</b> sait absolument tout, et boit beaucoup trop.",
      "Il revient depuis 1991 : onze romans à ce jour."
    ],
    note:'<b>un pelleteur de nuages</b> = a cloud shoveler',
    img:'adamsberg' },

  { kicker:'Le livre', h:'Pars vite et reviens tard',
    pts:[
      'Paru en <b>2001</b>. Troisième enquête d\u2019Adamsberg, et son septième roman.',
      'En tête des ventes en France pendant <b>plusieurs semaines</b> en 2001.',
      'Prix des Libraires et Grand prix des lectrices de Elle en 2002.'
    ],
    img:'livre' },

  { kicker:'Le titre', h:'Cito, longe, tarde', mark:true,
    lede:'Trois mots latins peints sous un grand 4 noir inversé, sur les portes des immeubles.',
    pts:[
      'Cela veut dire : <span class="flip"><span class="before">clique pour la traduction</span><span class="after">pars vite, va loin, reviens tard</span></span>.',
      "Pendant des siècles, c'était le <b>seul remède</b> connu contre la peste.",
      'On ne savait pas soigner, alors on fuyait.'
    ]},

  { kicker:'Le métier oublié', h:'Le crieur public',
    pts:[
      "Avant les journaux et la radio, un homme lisait les nouvelles <b>à voix haute</b> sur la place.",
      "Dans le roman, <b>Joss Le Guern</b>, ancien marin breton, a repris ce métier près de Montparnasse.",
      "Son arrière-grand-père le faisait déjà en Bretagne, cent ans plus tôt."
    ],
    img:'crieur' },

  { kicker:'Le vrai dans le faux', h:'Presque tout est authentique',
    pts:[
      "Les messages lus par le crieur viennent de <b>vrais livres anciens</b>.",
      "Le <em>Qanûn</em> d'Avicenne, un médecin qui a deviné très tôt le rôle des rats.",
      "Le journal de <b>Samuel Pepys</b>, sur la grande peste de Londres de 1665.",
      "En <b>1920</b>, une épidémie de peste a vraiment commencé près de Paris. Le gouvernement l'appelait « la maladie numéro 1 » pour ne pas affoler les gens."
    ],
    img:'avicenne' },

  { kicker:'La femme en colère', h:'L\u2019affaire Cesare Battisti',
    pts:[
      "Battisti, Italien né en 1954, a fait partie d'un groupe armé d'extrême gauche dans les <b>années 1970</b>.",
      "Condamné à la prison à vie en Italie, sans lui, pour quatre meurtres. Il a toujours nié, et il s'est enfui en France.",
      "Fred Vargas a repris le dossier <b>comme une archéologue</b> : tout lire, tout vérifier. Elle a publié un livre en 2004 pour le défendre.",
      "Extradé en <b>2019</b>, il a finalement reconnu les quatre meurtres.",
      "Quand elle croit à une cause, elle y va complètement."
    ],
    img:'battisti' },

  { kicker:'Aujourd\u2019hui', h:'Elle écrit toujours',
    pts:[
      "Traduite dans plus de <b>quarante langues</b>.",
      "Trois fois de suite le grand prix britannique du roman policier étranger : 2006, 2007, 2009. Personne n'avait jamais fait cela.",
      "<b>Prix Princesse des Asturies</b> en 2018.",
      "Son onzième Adamsberg, <em>Une unique lueur</em>, est sorti le <b>8 avril 2026</b>."
    ],
    img:'lueur' },

  { kicker:'La lanceuse d\u2019alerte', h:'Elle avait prévenu',
    pts:[
      "<b>29 avril 2006</b>, à la télévision : elle annonce une future pandémie mondiale et décrit ses conséquences.",
      "Quatorze ans plus tard, pendant le Covid, la télévision a ressorti l'extrait. Elle avait vu juste.",
      "Depuis, deux essais sur le climat : <em>L'humanité en péril</em> (2019), puis un livre sur la chaleur et l'alimentation (2022).",
      "Le crieur public de son roman, c'est peut-être elle !"
    ],
    link:{url:'https://www.youtube.com/watch?v=y_3Q-GWEsBo', t:'Regarder l\u2019extrait de 2006'},
    img:'ardisson' },

  { type:'end' }
];

const markSVG = (style) => `<svg class="mark" ${style} viewBox="0 0 200 240" aria-hidden="true">
  <path d="M150 15 L40 130 L165 130"/><line x1="150" y1="15" x2="150" y2="175"/>
  <line x1="120" y1="160" x2="180" y2="160"/><line x1="105" y1="185" x2="195" y2="185"/>
  <text class="clt" x="100" y="232" text-anchor="middle">C L T</text></svg>`;

function photoHTML(key, cls){
  const src = IMG[key] || '';
  return `<div class="photo ${cls||''} ${src?'filled':''}" tabindex="0" role="button" aria-label="Image">
    <div class="hint">Clique pour choisir une image</div>
    <img alt="" ${src?`src="${src}"`:''}>
    <button class="swap">Changer</button>
  </div>`;
}

function head(s){
  return `<div class="head"><img src="${IMG.logo}" alt="KingCretot Experience">
    <span class="kicker">${s.kicker||''}</span></div>`;
}

function render(s){
  const el = document.createElement('section');
  el.className = 'slide';

  if(s.type === 'cover'){
    el.classList.add('cover');
    el.innerHTML = head({kicker:''}) + `<div class="body"><div class="col"><div class="inner">
        ${markSVG('')}
        <h1>Fred Vargas</h1>
        <div class="sub">Qui est-elle ? Pourquoi ce roman ?</div>
        <div class="book">avant de commencer Pars vite et reviens tard</div>
      </div></div><div class="col">${photoHTML(s.img)}</div></div>`;
    return el;
  }

  if(s.type === 'end'){
    el.classList.add('end');
    el.innerHTML = head({kicker:''}) + `<div class="body solo"><div class="col">
      <div class="big">Bonne lecture !</div>
      <p>Ne cherche pas à tout comprendre du premier coup. Laisse-toi porter par les dialogues.</p>
      <p>On se retrouve chapitre par chapitre.</p>
    </div></div>`;
    return el;
  }

  let left = `<h2>${s.h}</h2>`;
  if(s.lede) left += `<p class="lede">${s.lede}</p>`;
  if(s.pts) left += `<ul class="pts">${s.pts.map(p=>`<li>${p}</li>`).join('')}</ul>`;
  if(s.quote) left += `<blockquote class="quote">${s.quote.t}<span>${s.quote.s}</span></blockquote>`;
  if(s.reveal) left += `<div class="reveal"><h3>${s.reveal.h}</h3>${s.reveal.p.map(x=>`<p>${x}</p>`).join('')}</div>`;
  if(s.note) left += `<p class="note">${s.note}</p>`;
  if(s.stats) left += `<div class="stats">${s.stats.map(x=>`<div class="stat"><div class="n">${x.n}</div><div class="t">${x.t}</div></div>`).join('')}</div>`;
  let right = '';
  if(s.img) right = photoHTML(s.img);
  else if(s.stack) right = `<div class="stack">${s.stack.map(k=>photoHTML(k)).join('')}</div>`;
  else if(s.mark) right = markSVG('style="width:46%;margin:0 auto;display:block"');
  if(s.punch) left += `<div class="punch">${s.punch}</div>`;
  if(s.link) right += `<div style="text-align:center"><a class="link" href="${s.link.url}" target="_blank" rel="noopener">${s.link.t}</a></div>`;

  el.innerHTML = head(s) + `<div class="body${right?'':' solo'}"><div class="col">${left}</div>${right?`<div class="col">${right}</div>`:''}</div>`;
  return el;
}

const deck = document.getElementById('deck');
slides.forEach(s=>deck.appendChild(render(s)));
const nodes = [...document.querySelectorAll('.slide')];

let cur = 0, step = 0;
const steps = (i) => [...nodes[i].querySelectorAll('.pts li, .stat, .punch, .reveal')];

function paint(){
  nodes.forEach((n,i)=>n.classList.toggle('on', i===cur));
  steps(cur).forEach((e,i)=>e.classList.toggle('show', i < step));
  document.getElementById('count').textContent = (cur+1) + ' / ' + nodes.length;
  document.getElementById('bar').style.width = ((cur+1)/nodes.length*100) + '%';
}
function forward(){
  const st = steps(cur);
  if(step < st.length){ step++; paint(); return; }
  if(cur < nodes.length-1){ cur++; step = 0; paint(); }
}
function back(){
  if(step > 0){ step--; paint(); return; }
  if(cur > 0){ cur--; step = steps(cur).length; paint(); }
}
document.getElementById('next').onclick = forward;
document.getElementById('prev').onclick = back;
document.addEventListener('keydown', e=>{
  if(e.target.tagName === 'INPUT') return;
  if(['ArrowRight','PageDown',' '].includes(e.key)){ e.preventDefault(); forward(); }
  if(['ArrowLeft','PageUp'].includes(e.key)){ e.preventDefault(); back(); }
});

document.addEventListener('click', e=>{
  const f = e.target.closest('.flip');
  if(f) f.classList.toggle('open');
});

const picker = document.getElementById('picker');
let target = null;
function load(file, box){
  if(!file || !file.type.startsWith('image/')) return;
  box.querySelector('img').src = URL.createObjectURL(file);
  box.classList.add('filled');
}
document.addEventListener('click', e=>{
  const box = e.target.closest('.photo');
  if(!box) return;
  target = box; picker.value = ''; picker.click();
});
picker.addEventListener('change', ()=>{ if(target) load(picker.files[0], target); });
document.addEventListener('dragover', e=>{
  const box = e.target.closest('.photo');
  if(box){ e.preventDefault(); box.classList.add('drag'); }
});
document.addEventListener('dragleave', e=>{
  const box = e.target.closest('.photo');
  if(box) box.classList.remove('drag');
});
document.addEventListener('drop', e=>{
  const box = e.target.closest('.photo');
  if(!box) return;
  e.preventDefault(); box.classList.remove('drag');
  load(e.dataTransfer.files[0], box);
});

paint();
</script>
</body>
</html>
